# .env.staging — fichier unique pour l'environnement staging.
# Copier en .env.staging sur le serveur avant le premier déploiement.
# NE PAS versionner ce fichier avec de vraies valeurs.
#
# Ce fichier sert à la fois :
#   - à docker compose pour la substitution des variables dans les fichiers YAML
#   - aux containers (via env_file: .env dans docker-compose.yml, symlinké sur .env.staging)

# --- Orchestration Docker (spécifique staging) ---
ENV_NAME=staging
COMPOSE_PROJECT_NAME=tenderai-staging
DOMAIN=stagingtenderai.yulcom.net
NGINX_HTTP_PORT=19080
NGINX_HTTPS_PORT=19443
IMAGE_TAG=staging
ENVIRONMENT=staging

# --- Sécurité (injectés automatiquement par le workflow CI depuis GitHub Secrets) ---
TENDERAI_JWT_SECRET=
TENDERAI_ADMIN_USERNAME=admin
TENDERAI_ADMIN_PASSWORD=

# --- Base de données (container postgres staging) ---
DATABASE_URL=postgresql://tenderai:tenderai_pass@postgres:5432/tenderai_bf
DATABASE_USER=tenderai
DATABASE_PASSWORD=tenderai_pass
DATABASE_NAME=tenderai_bf
POSTGRES_USER=tenderai
POSTGRES_PASSWORD=tenderai_pass
POSTGRES_DB=tenderai_bf

# --- MinIO (container minio staging) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=tenderai-bf
MINIO_SECURE=false

# --- SMTP Email ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=True
SMTP_USE_TLS=False
EMAIL_FROM=
EMAIL_FROM_NAME=TenderAI
EMAIL_TO_ADDRESS=
EMAIL_REPLY_TO=
EMAIL_SUBJECT_PREFIX="[STAGING] TenderAI"
EMAIL_SIGNATURE="YULCOM Technologies"
EMAIL_LOGO_URL=

# --- LLM ---
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Scheduler ---
CRON_SCHEDULE="0 7 * * *"
ENABLE_SCHEDULER=false

# --- Divers ---
LOG_LEVEL=INFO
TIMEZONE=Africa/Ouagadougou
